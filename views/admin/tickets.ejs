<%- include('../partials/admin-start') %>

<div class="page-head">
  <div><h1 style="font-size:1.35rem">Support tickets</h1><p class="lead">Customer conversations linked to their account and claims.</p></div>
</div>

<div class="table-wrap">
  <table class="table">
    <thead><tr><th>Ticket</th><th>Customer</th><th>Subject</th><th>Category</th><th>Priority</th><th>Status</th><th>Updated</th><th></th></tr></thead>
    <tbody>
      <% if (!tickets.length) { %><tr><td colspan="8"><div class="empty" style="padding:2rem"><p class="mb-0">No tickets.</p></div></td></tr><% } %>
      <% tickets.forEach(function (t) { var st = helpers.TICKET_STATUS[t.status]; %>
        <tr>
          <td class="mono small"><%= t.ticket_no %></td>
          <td class="small"><%= t.customer %></td>
          <td class="small"><a href="/admin/tickets/<%= t.id %>"><%= t.subject %></a><div class="small text-muted"><%= t.messages %> message(s)</div></td>
          <td class="small"><%= helpers.titleCase(t.category) %></td>
          <td><span class="badge is-<%= t.priority === 'urgent' || t.priority === 'high' ? 'danger' : t.priority === 'low' ? 'neutral' : 'info' %>"><%= helpers.titleCase(t.priority) %></span></td>
          <td><span class="badge is-<%= st.tone %>"><%= st.label %></span></td>
          <td class="small text-muted"><%= helpers.timeAgo(t.updated_at) %></td>
          <td class="text-right"><a class="btn btn-ghost btn-sm" href="/admin/tickets/<%= t.id %>">Open</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin-end') %>
