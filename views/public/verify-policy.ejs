<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main>
  <section class="section">
    <div class="container container-narrow">
      <div class="section-head center">
        <span class="eyebrow"><%= t('nav.verify') %></span>
        <h1 class="mt-1" style="font-size:clamp(1.8rem,3.4vw,2.5rem)">Check a policy status</h1>
        <p class="lead">Enter a vehicle registration number to confirm whether a policy is in force. No personal data is shown on this public lookup.</p>
      </div>

      <div class="card">
        <div class="card-body">
          <form action="/verify-policy" method="get" class="row" style="gap:.7rem;align-items:flex-end;flex-wrap:nowrap">
            <div class="field flex-1">
              <label for="reg">Vehicle registration number</label>
              <input class="input" id="reg" name="reg" required value="<%= reg %>" placeholder="MH12AB1234" style="text-transform:uppercase;letter-spacing:.08em;font-weight:600">
            </div>
            <button class="btn btn-primary" type="submit" style="height:42px">
              <svg class="icon"><use href="#i-search"/></svg> Check
            </button>
          </form>
          <div class="hint mt-1">Try the demo vehicle <b>MH12AB1234</b> (active) or <b>MH09IJ7755</b> (expired).</div>
        </div>
      </div>

      <% if (result) { %>
        <% if (result.notFound) { %>
          <div class="card mt-3">
            <div class="card-body empty">
              <svg class="icon"><use href="#i-search"/></svg>
              <h4>No vehicle found for <%= result.registration_no %></h4>
              <p>We could not find this registration number in the insurer dataset. Check the number, or contact the claims desk if your policy was issued recently.</p>
              <a class="btn btn-outline btn-sm" href="/contact">Contact support</a>
            </div>
          </div>
        <% } else { %>
          <div class="card mt-3 card-accent">
            <div class="card-head">
              <div>
                <div class="small text-muted">Vehicle</div>
                <h3><%= result.make %> <%= result.model %> · <%= result.year %></h3>
                <div class="mono" style="font-size:.85rem;color:var(--muted)"><%= result.registration_no %></div>
              </div>
              <% var active = result.status === 'active'; %>
              <span class="badge is-<%= active ? 'success' : 'danger' %>" style="font-size:.8rem;padding:.4rem .7rem">
                <svg class="icon"><use href="#i-<%= active ? 'check-circle' : 'alert' %>"/></svg>
                <%= active ? 'Policy active' : 'Policy ' + (result.status || 'not found') %>
              </span>
            </div>
            <% if (result.policy_number) { %>
              <div class="card-body">
                <dl class="kv" style="grid-template-columns:170px 1fr">
                  <dt>Policy number</dt><dd class="mono"><%= result.policy_number %></dd>
                  <dt>Insurer</dt><dd><%= result.insurer %></dd>
                  <dt>Cover type</dt><dd><%= helpers.POLICY_TYPE_LABELS[result.policy_type] || result.policy_type %></dd>
                  <dt>Policy period</dt><dd><%= helpers.formatDate(result.start_date) %> → <%= helpers.formatDate(result.end_date) %></dd>
                  <dt>Sum insured</dt><dd><%= helpers.formatCurrency(result.sum_insured) %></dd>
                  <dt>IDV</dt><dd><%= helpers.formatCurrency(result.idv) %></dd>
                </dl>
                <% if (active) { %>
                  <div class="note-box is-success mt-3 small">
                    This vehicle has active cover. Sign in to file a claim and upload the incident evidence.
                  </div>
                  <div class="flex mt-2">
                    <a class="btn btn-primary btn-sm" href="/login">Sign in to claim</a>
                    <a class="btn btn-outline btn-sm" href="/contact">Ask a question</a>
                  </div>
                <% } else { %>
                  <div class="note-box is-danger mt-3 small">
                    A claim is only payable if a policy was in force on the incident date. If you believe this is incorrect, contact the claims desk before filing.
                  </div>
                  <a class="btn btn-outline btn-sm mt-2" href="/contact">Contact the claims desk</a>
                <% } %>
              </div>
            <% } else { %>
              <div class="card-body">
                <div class="note-box is-warn">This vehicle is registered but has no policy linked to it in the dataset.</div>
              </div>
            <% } %>
          </div>
        <% } %>
      <% } %>

      <div class="grid grid-3 mt-4">
        <div class="soft"><b class="small">No account needed</b><p class="small text-muted mb-0">Public status check shows cover only — never personal details.</p></div>
        <div class="soft"><b class="small">Based on the live dataset</b><p class="small text-muted mb-0">Results are read directly from the insurer's policy records.</p></div>
        <div class="soft"><b class="small">Incident-date accuracy</b><p class="small text-muted mb-0">Coverage is assessed against the date of the incident, not today.</p></div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
