<header class="site-header">
  <div class="container">
    <nav class="nav">
      <a class="brand" href="/">
        <span class="brand-mark"><svg class="icon"><use href="#i-shield"/></svg></span>
        <span class="brand-text">
          <span class="brand-name">AutoClaim <span style="color:var(--gold-600)">AI</span></span>
          <span class="brand-sub"><%= t('brand.tagline') %></span>
        </span>
      </a>

      <div class="nav-links" id="primary-nav">
        <a class="nav-link <%= page === 'home' ? 'active' : '' %>" href="/"><%= t('nav.home') %></a>
        <a class="nav-link <%= page === 'about' ? 'active' : '' %>" href="/about"><%= t('nav.about') %></a>
        <a class="nav-link" href="/#how"><%= t('nav.how') %></a>
        <a class="nav-link <%= page === 'verify' ? 'active' : '' %>" href="/verify-policy"><%= t('nav.verify') %></a>
        <a class="nav-link <%= page === 'help' ? 'active' : '' %>" href="/help"><%= t('nav.help') %></a>
        <a class="nav-link <%= page === 'contact' ? 'active' : '' %>" href="/contact"><%= t('nav.contact') %></a>
        <% if (!currentUser) { %>
          <div class="only-mobile stack-sm" style="padding:.6rem 0 0;border-top:1px solid var(--border);margin-top:.5rem">
            <a class="btn btn-outline btn-block" href="/login"><%= t('nav.login') %></a>
            <a class="btn btn-primary btn-block" href="/register"><%= t('nav.register') %></a>
          </div>
        <% } %>
      </div>

      <div class="nav-actions">
        <details class="lang-menu">
          <summary class="icon-btn" title="<%= t('nav.language') %>" aria-label="<%= t('nav.language') %>">
            <svg class="icon"><use href="#i-globe"/></svg>
          </summary>
          <div class="menu">
            <div class="menu-head small text-muted"><%= t('nav.language') %></div>
            <% Object.keys(locales).forEach(function (code) { %>
              <a class="menu-item" href="<%= langUrl(code) %>">
                <span style="font-weight:700;font-size:.72rem;width:22px"><%= locales[code].short %></span>
                <%= locales[code].label %>
                <% if (code === locale) { %><svg class="icon" style="margin-left:auto"><use href="#i-check"/></svg><% } %>
              </a>
            <% }); %>
          </div>
        </details>

        <button class="icon-btn" type="button" data-theme-toggle title="<%= t('nav.theme') %>">
          <svg class="icon theme-ico-dark"><use href="#i-moon"/></svg>
          <svg class="icon theme-ico-light"><use href="#i-sun"/></svg>
        </button>

        <% if (currentUser) { %>
          <a class="icon-btn" href="/app/notifications" title="<%= t('nav.notifications') %>">
            <svg class="icon"><use href="#i-bell"/></svg>
            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %><span class="dot"></span><% } %>
          </a>
          <details class="user-menu">
            <summary>
              <span class="avatar"><%= helpers.initials(currentUser.full_name) %></span>
              <span class="hide-mobile" style="font-size:.82rem;font-weight:600;padding-right:.25rem"><%= currentUser.full_name.split(' ')[0] %></span>
            </summary>
            <div class="menu">
              <div class="menu-head">
                <div class="fw-600"><%= currentUser.full_name %></div>
                <div class="small text-muted truncate"><%= currentUser.email %></div>
              </div>
              <% if (currentUser.role === 'admin') { %>
                <a class="menu-item" href="/admin"><svg class="icon"><use href="#i-chart"/></svg><%= t('nav.admin') %></a>
              <% } %>
              <a class="menu-item" href="/app"><svg class="icon"><use href="#i-home"/></svg><%= t('nav.dashboard') %></a>
              <a class="menu-item" href="/app/claims"><svg class="icon"><use href="#i-clipboard"/></svg><%= t('nav.claims') %></a>
              <a class="menu-item" href="/app/policies"><svg class="icon"><use href="#i-shield"/></svg><%= t('nav.policies') %></a>
              <a class="menu-item" href="/app/vehicles"><svg class="icon"><use href="#i-car"/></svg><%= t('nav.vehicles') %></a>
              <a class="menu-item" href="/app/profile"><svg class="icon"><use href="#i-user"/></svg><%= t('nav.profile') %></a>
              <a class="menu-item" href="/app/support"><svg class="icon"><use href="#i-message"/></svg><%= t('nav.support') %></a>
              <div class="menu-sep"></div>
              <form action="/logout" method="post">
                <button class="menu-item" type="submit" style="width:100%;border:0;background:none;cursor:pointer;font:inherit">
                  <svg class="icon"><use href="#i-log-out"/></svg><%= t('nav.logout') %>
                </button>
              </form>
            </div>
          </details>
        <% } else { %>
          <a class="btn btn-ghost btn-sm hide-mobile" href="/login"><%= t('nav.login') %></a>
          <a class="btn btn-primary btn-sm hide-mobile" href="/register"><%= t('nav.register') %></a>
        <% } %>

        <button class="icon-btn nav-toggle" type="button" data-nav-toggle aria-label="<%= t('nav.menu') %>">
          <svg class="icon"><use href="#i-menu"/></svg>
        </button>
      </div>
    </nav>
  </div>
</header>
