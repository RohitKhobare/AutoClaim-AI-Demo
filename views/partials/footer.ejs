<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" style="margin-bottom:.9rem">
          <span class="brand-mark"><svg class="icon"><use href="#i-shield"/></svg></span>
          <span class="brand-text">
            <span class="brand-name">AutoClaim <span style="color:var(--gold-600)">AI</span></span>
            <span class="brand-sub"><%= t('brand.tagline') %></span>
          </span>
        </a>
        <p class="small text-muted" style="max-width:34ch"><%= t('footer.tagline') %></p>
        <div class="flex" style="gap:.4rem">
          <span class="pill">OCR + RAG</span>
          <span class="pill">YOLOv11</span>
          <span class="pill">Explainable AI</span>
        </div>
      </div>

      <div>
        <h5><%= t('footer.product') %></h5>
        <div class="footer-links">
          <a href="/#pipeline"><%= t('nav.how') %></a>
          <a href="/verify-policy"><%= t('footer.verify') %></a>
          <a href="/app/claims/new"><%= t('footer.claims') %></a>
          <a href="/#security"><%= t('footer.security') %></a>
          <a href="/#faq"><%= t('nav.help') %></a>
        </div>
      </div>

      <div>
        <h5><%= t('footer.company') %></h5>
        <div class="footer-links">
          <a href="/about"><%= t('footer.about') %></a>
          <a href="/help"><%= t('footer.help') %></a>
          <a href="/contact"><%= t('nav.contact') %></a>
          <a href="/terms"><%= t('footer.terms') %></a>
          <a href="/login"><%= t('nav.login') %></a>
        </div>
      </div>

      <div>
        <h5><%= t('footer.contact') %></h5>
        <div class="footer-contact">
          <a href="tel:<%= contact.phone %>"><svg class="icon"><use href="#i-phone"/></svg>+91 <%= contact.phone %></a>
          <a href="mailto:<%= contact.email %>"><svg class="icon"><use href="#i-mail"/></svg><%= contact.email %></a>
          <span><svg class="icon"><use href="#i-map-pin"/></svg><%= company.insurer %></span>
          <span class="small text-muted"><%= contact.person %> · Claims support</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© <%= new Date().getFullYear() %> AutoClaim AI · <%= t('footer.rights') %></span>
      <span class="flex" style="gap:1rem">
        <a href="/terms"><%= t('footer.privacy') %></a>
        <a href="/terms"><%= t('footer.terms') %></a>
        <span>v<%= version %></span>
      </span>
    </div>
  </div>
</footer>
<script src="/js/app.js" defer></script>
</body>
</html>
