<!doctype html>
<html lang="<%= locale %>" data-theme="<%= currentUser ? currentUser.theme : 'light' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' + appName : appName + ' — ' + t('brand.tagline') %></title>
  <meta name="description" content="AutoClaim AI verifies documents, detects manipulated accident photos, assesses vehicle damage and settles motor insurance claims with a complete, explainable AI report.">
  <meta name="theme-color" content="#0f5132">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <script>
    (function () {
      try {
        var stored = localStorage.getItem('autoclaim-theme');
        if (stored) document.documentElement.setAttribute('data-theme', stored);
      } catch (e) {}
    })();
  </script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<%- include('icons') %>
<%- include('flash') %>
