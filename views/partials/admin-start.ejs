<%- include('../partials/head') %>
<div class="shell">
  <aside class="sidebar">
    <a class="brand" href="/admin">
      <span class="brand-mark"><svg class="icon"><use href="#i-shield"/></svg></span>
      <span class="brand-text">
        <span class="brand-name">AutoClaim AI</span>
        <span class="brand-sub">Admin console</span>
      </span>
    </a>

    <div class="side-group">
      <div class="side-label">Operations</div>
      <a class="side-link <%= page === 'dashboard' ? 'active' : '' %>" href="/admin"><svg class="icon"><use href="#i-chart"/></svg> Dashboard</a>
      <a class="side-link <%= page === 'claims' ? 'active' : '' %>" href="/admin/claims"><svg class="icon"><use href="#i-clipboard"/></svg> Claims queue</a>
      <a class="side-link" href="/admin/claims/new"><svg class="icon"><use href="#i-plus"/></svg> Register claim</a>
      <a class="side-link <%= page === 'payments' ? 'active' : '' %>" href="/admin/payments"><svg class="icon"><use href="#i-wallet"/></svg> Payments</a>
    </div>

    <div class="side-group">
      <div class="side-label">Dataset</div>
      <a class="side-link <%= page === 'customers' ? 'active' : '' %>" href="/admin/customers"><svg class="icon"><use href="#i-users"/></svg> Customers</a>
      <a class="side-link <%= page === 'vehicles' ? 'active' : '' %>" href="/admin/vehicles"><svg class="icon"><use href="#i-car"/></svg> Vehicles</a>
      <a class="side-link <%= page === 'policies' ? 'active' : '' %>" href="/admin/policies"><svg class="icon"><use href="#i-shield"/></svg> Policies</a>
      <a class="side-link <%= page === 'import' ? 'active' : '' %>" href="/admin/import"><svg class="icon"><use href="#i-database"/></svg> Import CSV</a>
    </div>

    <div class="side-group">
      <div class="side-label">Communication</div>
      <a class="side-link <%= page === 'tickets' ? 'active' : '' %>" href="/admin/tickets"><svg class="icon"><use href="#i-message"/></svg> Support tickets</a>
      <a class="side-link <%= page === 'messages' ? 'active' : '' %>" href="/admin/messages"><svg class="icon"><use href="#i-mail"/></svg> Enquiries</a>
    </div>

    <div class="side-group">
      <div class="side-label">System</div>
      <a class="side-link <%= page === 'audit' ? 'active' : '' %>" href="/admin/audit"><svg class="icon"><use href="#i-activity"/></svg> Audit trail</a>
      <a class="side-link <%= page === 'settings' ? 'active' : '' %>" href="/admin/settings"><svg class="icon"><use href="#i-settings"/></svg> AI settings</a>
      <a class="side-link" href="/"><svg class="icon"><use href="#i-external"/></svg> View website</a>
    </div>

    <div class="side-foot">
      <div class="flex" style="gap:.55rem;margin-bottom:.6rem">
        <span class="avatar" style="width:30px;height:30px;font-size:.7rem"><%= helpers.initials(currentUser.full_name) %></span>
        <div style="min-width:0"><b class="small truncate" style="display:block"><%= currentUser.full_name %></b><span class="small text-muted truncate" style="display:block"><%= currentUser.email %></span></div>
      </div>
      <form action="/logout" method="post"><button class="btn btn-ghost btn-sm btn-block" type="submit" style="justify-content:flex-start"><svg class="icon"><use href="#i-log-out"/></svg> Sign out</button></form>
    </div>
  </aside>
  <div class="sidebar-backdrop" data-sidebar-toggle></div>

  <div class="main">
    <div class="topbar">
      <div class="flex" style="gap:.75rem">
        <button class="icon-btn only-mobile" type="button" data-sidebar-toggle aria-label="Menu"><svg class="icon"><use href="#i-menu"/></svg></button>
        <div>
          <h1><%= title %></h1>
          <div class="sub">Admin console · <%= company.insurer %></div>
        </div>
      </div>
      <div class="flex" style="gap:.4rem">
        <button class="icon-btn" type="button" data-theme-toggle title="Theme">
          <svg class="icon theme-ico-dark"><use href="#i-moon"/></svg>
          <svg class="icon theme-ico-light"><use href="#i-sun"/></svg>
        </button>
        <a class="icon-btn" href="/app" title="Customer view"><svg class="icon"><use href="#i-user"/></svg></a>
      </div>
    </div>
    <div class="content">
