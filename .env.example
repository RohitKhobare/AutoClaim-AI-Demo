# ─────────────────────────────────────────────────────────────
#  AutoClaim AI — environment configuration
#  Copy this file to `.env` and edit the values for your machine.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
APP_NAME=AutoClaim AI
APP_URL=http://localhost:3000

# Session
SESSION_SECRET=change-this-to-a-long-random-string
TRUST_PROXY=false

# ── MySQL (local XAMPP / MySQL Workbench / MariaDB) ──────────
# XAMPP default: user=root, password= (empty)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autoclaim_ai
DB_SSL=false

# ── File uploads ─────────────────────────────────────────────
UPLOAD_DIR=public/uploads
MAX_UPLOAD_MB=12

# ── AI decision thresholds (used by src/services/ai-engine.js)
AI_AUTO_APPROVE_CONFIDENCE=88
AI_MAX_FRAUD_SCORE=0.28
AI_MAX_IMAGE_AI_PROBABILITY=22

# ── Razorpay ─────────────────────────────────────────────────
# Leave both empty to run in DEMO MODE (simulated checkout, no real money).
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Demo data ────────────────────────────────────────────────
# Password given to every seeded account (demo only)
DEMO_PASSWORD=Auto@123
ADMIN_DEMO_PASSWORD=change-this-to-a-private-password
